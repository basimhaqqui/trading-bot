# Milestone 1 has no venue credentials and cannot place live orders.
TRADING_DB_PATH=var/trading.db

# Replace in production with a secret from a managed secret store.
# It signs risk approvals; it is not a broker or withdrawal credential.
RISK_SIGNING_KEY=development-only-change-me

# Hard system-wide research limits used by the demo risk governor.
MAX_GROSS_NOTIONAL=100000
MAX_INSTRUMENT_NOTIONAL=10000
MAX_VENUE_NOTIONAL=30000
MAX_MEMECOIN_NOTIONAL=0
MAX_PREDICTION_NOTIONAL=5000
