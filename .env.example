# Milestone 1 has no venue credentials and cannot place live orders.
TRADING_DB_PATH=var/trading.db

# Optional read-only market-data access. Jobs remain dormant until both are set.
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET_KEY=

# Optional explicit aliases for the same Alpaca paper account credentials.
# The paper commands fall back to the market-data values when these are blank.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# A paper order needs this flag, an unlocked database control, a CLI confirmation,
# and strategy eligibility. Keep false while evidence gates are collecting.
ALPACA_PAPER_TRADING_ENABLED=false

# Replace in production with a secret from a managed secret store.
# It signs risk approvals; it is not a broker or withdrawal credential.
RISK_SIGNING_KEY=development-only-change-me

# Hard system-wide research limits used by the demo risk governor.
MAX_GROSS_NOTIONAL=100000
MAX_INSTRUMENT_NOTIONAL=10000
MAX_VENUE_NOTIONAL=30000
MAX_MEMECOIN_NOTIONAL=0
MAX_PREDICTION_NOTIONAL=5000
MAX_EQUITY_NOTIONAL=30000
MAX_OPTION_NOTIONAL=10000
